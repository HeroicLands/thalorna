{
    "name": "thalorna",
    "private": true,
    "productName": "Thalorna Setting",
    "version": "0.1.0",
    "author": {
        "name": "Tom Rodriguez",
        "email": "toasty@heroiclands.org",
        "url": "https://www.heroiclands.org"
    },
    "x-contact": {
        "discord": "toasty#8538",
        "bluesky": "@toasty.heroiclands.org"
    },
    "homepage": "https://www.heroiclands.org/thalorna/",
    "license": "GPL-3.0-or-later AND CC-BY-SA-4.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/HeroicLands/thalorna"
    },
    "bugs": "https://github.com/HeroicLands/thalorna/issues",
    "engines": {
        "node": ">=24.0.0"
    },
    "type": "module",
    "scripts": {
        "prepare": "git config core.hooksPath node_modules/@heroiclands/package-build/githooks || true",
        "clean": "package-build clean",
        "distclean": "package-build clean --distclean",
        "build": "npm ci && npm run build:noci",
        "build:local": "npm i && npm run build:noci",
        "build:noci": "run-s build:deps lint build:stage-reset build:db build:module",
        "build:stage-reset": "package-build stage reset",
        "build:deps": "package-build deps fetch",
        "build:db": "run-s build:deps build:content-index build:calendars build:assets build:compiledb",
        "build:assets": "package-build assets",
        "build:compiledb": "package-build package compile",
        "build:unpackdb": "package-build package unpack",
        "lint": "run-s lint:format lint:markdown lint:lang lint:addresses lint:content-links lint:reference-people lint:labels",
        "lint:format": "package-build format",
        "lint:markdown": "package-build markdown",
        "lint:markdown:fix": "package-build markdown --fix",
        "lint:content-links": "package-build links",
        "lint:addresses": "package-build lint",
        "build:site-content": "package-build site",
        "build:site": "run-s build:deps build:site-content build:site-html build:site-root",
        "build:site-html": "hugo --source build/hugo --minify --gc --cleanDestinationDir",
        "build:site-root": "package-build site-root",
        "build:book": "package-build pdf",
        "serve:site": "npm run build:site-content && hugo server --source build/hugo",
        "build:pack-release": "package-build release",
        "push:dev": "package-build deploy dev",
        "push:qa": "package-build deploy qa",
        "push:prod": "package-build deploy prod",
        "push:local-dev": "npm run push:qa",
        "deploy:local": "npm run deploy:qa",
        "deploy:qa": "run-s build push:qa",
        "deploy:dev": "run-s build push:dev",
        "deploy:prod": "run-s build push:prod",
        "deploy:release": "run-s build build:pack-release",
        "format": "package-build format --write",
        "format:check": "package-build format",
        "changeset": "changeset",
        "changeset:version": "changeset version && package-build changelog group && npm install --package-lock-only",
        "changeset:check": "changeset status --since=origin/main",
        "build:content-index": "package-build content-index",
        "build:calendars": "package-build calendars --calendaria-version 1.4.2",
        "lint:lang": "package-build lang check",
        "lint:reference-people": "node utils/reference-people.mjs",
        "lint:labels": "package-build labels check",
        "build:module": "package-build manifest",
        "lint:khazari-lexicon": "node utils/lexicons/khazari-lexicon.mjs",
        "lint:khelathi-lexicon": "node utils/lexicons/khelathi-lexicon.mjs",
        "lint:drift": "node utils/nordmal-drift.mjs",
        "lint:nordmal-lexicon": "node utils/lexicons/nordmal-lexicon.mjs",
        "lint:nordmal-concordance": "node utils/nordmal-concordance-check.mjs",
        "lint:sinale-lexicon": "node utils/lexicons/sinale-lexicon.mjs",
        "lint:varokhi-lexicon": "node utils/lexicons/varokhi-lexicon.mjs",
        "lint:collision": "node utils/lexicons/collision-check.mjs"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@heroiclands/package-build": "^23.0.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.9",
        "yaml": "^2.9.0"
    }
}
